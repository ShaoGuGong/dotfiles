layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="file:/home/shaogu/.config/zellij/plugins/zjstatus.wasm" {
                // set colors alias
                color_sumiInk0 "#16161D"
                color_sumiInk1 "#181820"
                color_oldWhite "#C8C093"
                color_fujiWhite "#DCD7BA"
                color_fujiGray "#727169"
                color_crystalBlue "#7E9CD8"
                color_lightBlue "#A3D4D5"
                color_springGreen "#98BB6C"
                color_carpYellow "#E6C384"
                color_waveRed "#E46876"
                color_peachRed "#FF5D62"
                color_surimiOrange "#FFA066"
                format_left "{mode}#[bg=$sumiInk0]"
                format_center "#[bg=$sumiInk0,fg=$oldWhite] {tabs}"
                format_right "#[bg=$sumiInk0,fg=$oldWhite] {swap_layout} #[bg=$sumiInk0,fg=$oldWhite]  {session} {datetime}"
                // format_right  "#[bg=$sumiInk0,fg=$oldWhite] {pipe_zjstatus_hints}"
                format_space "#[bg=$sumiInk0]"
                format_hide_on_overlength "true"
                format_precedence "crl"
                border_enabled "false"
                border_char "─"
                border_format "#[fg=$carpYellow]{char}"
                border_position "top"
                mode_normal "#[bg=$sumiInk0,fg=$springGreen]#[bg=$springGreen,fg=$sumiInk0,bold] NORMAL 󰊠 #[bg=$sumiInk0,fg=$springGreen]"
                mode_locked "#[bg=$sumiInk0,fg=$fujiWhite]#[bg=$fujiWhite,fg=$sumiInk0,bold] LOCKED  #[bg=$sumiInk0,fg=$fujiWhite]"
                mode_resize "#[bg=$sumiInk0,fg=$crystalBlue]#[bg=$crystalBlue,fg=$sumiInk0,bold] RESIZE 󰘕 #[bg=$sumiInk0,fg=$crystalBlue]"
                mode_pane "#[bg=$sumiInk0,fg=$crystalBlue]#[bg=$crystalBlue,fg=$sumiInk0,bold] PANE  #[bg=$sumiInk0,fg=$crystalBlue]"
                mode_tab "#[bg=$sumiInk0,fg=$crystalBlue]#[bg=$crystalBlue,fg=$sumiInk0,bold] TAB 󰓩 #[bg=$sumiInk0,fg=$crystalBlue]"
                mode_scroll "#[bg=$sumiInk0,fg=$crystalBlue]#[bg=$crystalBlue,fg=$sumiInk0,bold] SCROLL  #[bg=$sumiInk0,fg=$crystalBlue]"
                mode_enter_search "#[bg=$sumiInk0,fg=$waveRed]#[bg=$waveRed,fg=$sumiInk0,bold] ENT-SEARCH  #[bg=$sumiInk0,fg=$waveRed]"
                mode_search "#[bg=$sumiInk0,fg=$crystalBlue]#[bg=$crystalBlue,fg=$sumiInk0,bold] SEARCHARCH  #[bg=$sumiInk0,fg=$crystalBlue]"
                mode_rename_tab "#[bg=$sumiInk0,fg=$crystalBlue]#[bg=$crystalBlue,fg=$sumiInk0,bold] RENAME-TAB  #[bg=$sumiInk0,fg=$crystalBlue]"
                mode_rename_pane "#[bg=$sumiInk0,fg=$crystalBlue]#[bg=$crystalBlue,fg=$sumiInk0,bold] RENAME-PANE  #[bg=$sumiInk0,fg=$crystalBlue]"
                mode_session "#[bg=$sumiInk0,fg=$oniViolet]#[bg=$oniViolet,fg=$sumiInk0,bold] SESSION  #[bg=$sumiInk0,fg=$oniViolet]"
                mode_move "#[bg=$sumiInk0,fg=$crystalBlue]#[bg=$crystalBlue,fg=$sumiInk0,bold] MOVE 󰆾 #[bg=$sumiInk0,fg=$crystalBlue]"
                mode_prompt "#[bg=$sumiInk0,fg=$crystalBlue]#[bg=$crystalBlue,fg=$sumiInk0,bold] PROMPT #[bg=$sumiInk0,fg=$crystalBlue]"
                mode_tmux "#[bg=$sumiInk0,fg=$surimiOrange]#[bg=$surimiOrange,fg=$sumiInk0,bold] TMUX #[bg=$sumiInk0,fg=$surimiOrange]"
                // formatting for inactive tabs
                tab_normal "#[bg=$sumiInk0,fg=$lightBlue]#[bg=$lightBlue,fg=$sumiInk1,bold]{index} #[bg=$fujiGray,fg=$lightBlue,bold] {name}{floating_indicator}#[bg=$sumiInk0,fg=$fujiGray,bold]"
                tab_normal_fullscreen "#[bg=$sumiInk0,fg=$lightBlue]#[bg=$lightBlue,fg=$sumiInk1,bold]{index} #[bg=$fujiGray,fg=$lightBlue,bold] {name}{fullscreen_indicator}#[bg=$sumiInk0,fg=$fujiGray,bold]"
                tab_normal_sync "#[bg=$sumiInk0,fg=$lightBlue]#[bg=$lightBlue,fg=$sumiInk1,bold]{index} #[bg=$fujiGray,fg=$lightBlue,bold] {name}{sync_indicator}#[bg=$sumiInk0,fg=$fujiGray,bold]"
                // formatting for the current active tab
                tab_active "#[bg=$sumiInk0,fg=$oldWhite]#[bg=$oldWhite,fg=$sumiInk1,bold]{index} #[bg=$fujiGray,fg=$oldWhite,bold,italic] {name}{floating_indicator}#[bg=$sumiInk0,fg=$fujiGray,bold]"
                tab_active_fullscreen "#[bg=$sumiInk0,fg=$oldWhite]#[bg=$oldWhite,fg=$sumiInk1,bold]{index} #[bg=$fujiGray,fg=$oldWhite,bold,italic] {name}{fullscreen_indicator}#[bg=$sumiInk0,fg=$fujiGray,bold]"
                tab_active_sync "#[bg=$sumiInk0,fg=$oldWhite]#[bg=$oldWhite,fg=$sumiInk1,bold]{index} #[bg=$fujiGray,fg=$oldWhite,bold,italic] {name}{sync_indicator}#[bg=$sumiInk0,fg=$fujiGray,bold]"
                // separator between the tabs
                tab_separator "#[bg=$sumiInk0] "
                // indicators
                tab_sync_indicator "  "
                tab_fullscreen_indicator " 󰊓 "
                tab_floating_indicator " 󰹙 "
                command_git_branch_command "git rev-parse --abbrev-ref HEAD"
                command_git_branch_format "#[fg=blue] {stdout} "
                command_git_branch_interval "10"
                command_git_branch_rendermode "static"
                datetime "#[bg=$sumiInk0,fg=$oldWhite]#[bg=$oldWhite,fg=$sumiInk0,bold] {format} #[bg=$sumiInk0,fg=$oldWhite]"
                datetime_format "%H:%M"
                datetime_timezone "Asia/Taipei"
            }
        }
        children
 // pane size=1 borderless=true {
        //     plugin location="file:/home/shaogu/.config/zellij/plugins/zjstatus.wasm" {
        //         format_left  "{pipe_zjstatus_hints}"
        //         format_center ""
        //         format_right ""
        //         pipe_zjstatus_hints_format "{output}"
        //     }
        // }
    }
    swap_tiled_layout name="vertical" {
        tab max_panes=5 {
            pane split_direction="vertical" {
                pane
                pane {
                    children
                }
            }
        }
        tab max_panes=8 {
            pane split_direction="vertical" {
                pane {
                    children
                }
                pane {
                    pane
                    pane
                    pane
                    pane
                }
            }
        }
        tab max_panes=12 {
            pane split_direction="vertical" {
                pane {
                    children
                }
                pane {
                    pane
                    pane
                    pane
                    pane
                }
                pane {
                    pane
                    pane
                    pane
                    pane
                }
            }
        }
    }
    swap_tiled_layout name="horizontal" {
        tab max_panes=5 {
            pane
            pane
        }
        tab max_panes=8 {
            pane {
                pane split_direction="vertical" {
                    children
                }
                pane split_direction="vertical" {
                    pane
                    pane
                    pane
                    pane
                }
            }
        }
        tab max_panes=12 {
            pane {
                pane split_direction="vertical" {
                    children
                }
                pane split_direction="vertical" {
                    pane
                    pane
                    pane
                    pane
                }
                pane split_direction="vertical" {
                    pane
                    pane
                    pane
                    pane
                }
            }
        }
    }
    swap_tiled_layout name="stacked" {
        tab min_panes=5 {
            pane split_direction="vertical" {
                pane
                pane stacked=true {
                    children
                }
            }
        }
    }
    swap_floating_layout name="staggered" {
        floating_panes
    }
    swap_floating_layout name="enlarged" {
        floating_panes max_panes=10 {
            pane {
                x "5%"
                y 1
                width "90%"
                height "90%"
            }
            pane {
                x "5%"
                y 2
                width "90%"
                height "90%"
            }
            pane {
                x "5%"
                y 3
                width "90%"
                height "90%"
            }
            pane {
                x "5%"
                y 4
                width "90%"
                height "90%"
            }
            pane {
                x "5%"
                y 5
                width "90%"
                height "90%"
            }
            pane {
                x "5%"
                y 6
                width "90%"
                height "90%"
            }
            pane {
                x "5%"
                y 7
                width "90%"
                height "90%"
            }
            pane {
                x "5%"
                y 8
                width "90%"
                height "90%"
            }
            pane {
                x "5%"
                y 9
                width "90%"
                height "90%"
            }
            pane focus=true {
                x 10
                y 10
                width "90%"
                height "90%"
            }
        }
    }
    swap_floating_layout name="spread" {
        floating_panes max_panes=1 {
            pane {
                y "50%"
                x "50%"
            }
        }
        floating_panes max_panes=2 {
            pane {
                x "1%"
                y "25%"
                width "45%"
            }
            pane {
                x "50%"
                y "25%"
                width "45%"
            }
        }
        floating_panes max_panes=3 {
            pane focus=true {
                y "55%"
                width "45%"
                height "45%"
            }
            pane {
                x "1%"
                y "1%"
                width "45%"
            }
            pane {
                x "50%"
                y "1%"
                width "45%"
            }
        }
        floating_panes max_panes=4 {
            pane {
                x "1%"
                y "55%"
                width "45%"
                height "45%"
            }
            pane focus=true {
                x "50%"
                y "55%"
                width "45%"
                height "45%"
            }
            pane {
                x "1%"
                y "1%"
                width "45%"
                height "45%"
            }
            pane {
                x "50%"
                y "1%"
                width "45%"
                height "45%"
            }
        }
    }
}

